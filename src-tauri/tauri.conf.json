{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PumatVPN",
  "version": "0.1.0",
  "identifier": "com.kivalov.pumatvpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PumatVPN",
        "width": 480,
        "height": 620,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.svg"
    ]
  }
}
